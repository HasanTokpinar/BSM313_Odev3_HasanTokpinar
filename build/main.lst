 115:Core/Src/main.c ****   // Cihaz açıldığında Flash'tan değeri oku
 116:Core/Src/main.c ****   uint32_t flash_val = Read_From_Flash();
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****   // Sistem açılışında butona basılı tutuluyor mu kontrolü (Fabrika ayarlarına dönüş)
 119:Core/Src/main.c ****   if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) {
 120:Core/Src/main.c ****       uint32_t start_time = HAL_GetTick();
 121:Core/Src/main.c ****       uint8_t factory_reset = 0;
 122:Core/Src/main.c ****       
 123:Core/Src/main.c ****       // Buton basılı olduğu sürece bekle
 124:Core/Src/main.c ****       while (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) {
 125:Core/Src/main.c ****           if (HAL_GetTick() - start_time >= 3000) { // 3 saniye dolduysa
 126:Core/Src/main.c ****               blink_count = 4;
 127:Core/Src/main.c ****               Save_To_Flash(blink_count);
 128:Core/Src/main.c ****               factory_reset = 1;
 129:Core/Src/main.c ****               break; // 3 saniye dolunca döngüden çık
 130:Core/Src/main.c ****           }
 131:Core/Src/main.c ****       }
 132:Core/Src/main.c ****       
 133:Core/Src/main.c ****       // Kullanıcı butonu bırakana kadar programı beklet
 134:Core/Src/main.c ****       while (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET);
 135:Core/Src/main.c ****       
 136:Core/Src/main.c ****       // Eğer 3 saniyeden az basıldıysa normal başlatma işlemine devam et
 137:Core/Src/main.c ****       if (!factory_reset) {
 138:Core/Src/main.c ****           if (flash_val > 7 || flash_val < 4) {
 139:Core/Src/main.c ****               blink_count = 4;
 140:Core/Src/main.c ****               Save_To_Flash(blink_count);
 141:Core/Src/main.c ****           } else {
 142:Core/Src/main.c ****               blink_count = flash_val;
 143:Core/Src/main.c ****           }
 144:Core/Src/main.c ****       }
 145:Core/Src/main.c ****   } else {
 146:Core/Src/main.c ****       // Cihaz açılırken butona basılmamışsa normal şekilde devam et
 147:Core/Src/main.c ****       if (flash_val > 7 || flash_val < 4) {
ARM GAS  C:\Users\Acer\AppData\Local\Temp\ccFlOBVR.s 			page 4


 148:Core/Src/main.c ****           blink_count = 4;
 149:Core/Src/main.c ****           Save_To_Flash(blink_count);
 150:Core/Src/main.c ****       } else {
 151:Core/Src/main.c ****           blink_count = flash_val;
 152:Core/Src/main.c ****       }
 153:Core/Src/main.c ****   }
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****   // Timer 2 kesmesini başlat
 156:Core/Src/main.c ****   HAL_TIM_Base_Start_IT(&htim2);
 157:Core/Src/main.c **** /* USER CODE END 2 */
 158:Core/Src/main.c **** 
 159:Core/Src/main.c ****   /* Infinite loop */
 160:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 161:Core/Src/main.c ****   while (1)
 162:Core/Src/main.c ****   {
 163:Core/Src/main.c ****     /* USER CODE END WHILE */
 164:Core/Src/main.c **** 
 165:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 166:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) { 
 167:Core/Src/main.c ****         HAL_Delay(50); // Dalgalanmayı önlemek için Debounce
 168:Core/Src/main.c ****         
 169:Core/Src/main.c ****         if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) {
 170:Core/Src/main.c ****             
 171:Core/Src/main.c ****             // Kullanıcı butonu (veya switch'i) bırakana kadar bekle
 172:Core/Src/main.c ****             while (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET);
 173:Core/Src/main.c ****             
 174:Core/Src/main.c ****             blink_count++;
 175:Core/Src/main.c ****             if (blink_count > 7) blink_count = 4;
 176:Core/Src/main.c ****             Save_To_Flash(blink_count);
 177:Core/Src/main.c ****             
 178:Core/Src/main.c ****             // Yeni değerin hemen tepki vermesi için sayacı sıfırla
 179:Core/Src/main.c ****             toggle_count = 0;
 180:Core/Src/main.c ****             wait_seconds = 0;
 181:Core/Src/main.c ****             state = 0;
 182:Core/Src/main.c ****             HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, GPIO_PIN_SET); // LED'i söndür
 183:Core/Src/main.c ****         }
 184:Core/Src/main.c ****     }
 185:Core/Src/main.c **** /* USER CODE END 3 */
